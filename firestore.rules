rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function memberRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    function isParent(familyId) {
      return isFamilyMember(familyId) && memberRole(familyId) == 'parent';
    }

    function rewardRequiresApproval(familyId, rewardId) {
      return get(/databases/$(database)/documents/families/$(familyId)/rewards/$(rewardId)).data.approvalRequired;
    }

    function templatePhotoRequired(familyId, templateId) {
      return get(/databases/$(database)/documents/families/$(familyId)/taskTemplates/$(templateId)).data.get('photoRequired', false) == true;
    }

    // If the task's template requires a photo, the resulting document must
    // already carry one — enforced server-side so a photo-required task
    // can't be marked complete via a raw API call that skips the upload.
    function photoRequirementMet(familyId, templateId, data) {
      return !templatePhotoRequired(familyId, templateId) || (data.photoUrl is string && data.photoUrl.size() > 0);
    }

    // A proposal responding to someone else's TaskRequest must target an
    // open request that isn't the proposer's own, and must be assigned to
    // the requester (not the proposer) — the whole point is other members
    // suggesting a task *for* the person who asked.
    function validRequestProposal(familyId, requestId, proposedBy, assignedTo) {
      let req = get(/databases/$(database)/documents/families/$(familyId)/taskRequests/$(requestId)).data;
      return req.status == 'open' && req.requestedBy != proposedBy && assignedTo == [req.requestedBy];
    }

    // users/{userId} maps a signed-in user to their familyId so the client can
    // resolve family membership after login. Only ever written by trusted
    // server code (Cloud Functions using the Admin SDK) — see createFamily /
    // joinFamily — never directly by clients.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow write: if isParent(familyId);

      match /members/{userId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isParent(familyId);
        allow delete: if isParent(familyId);
        // xpBalance/currentStreak/lastActiveDate are never client-writable —
        // only the onTaskCompleted/onRedemptionApproved Cloud Functions
        // (Admin SDK, bypasses rules) ever change them. Parents may edit any
        // member's profile fields (including role); a member may always edit
        // their own name/avatar/push token, but never their own role — role
        // changes must go through a parent.
        allow update: if
          (isParent(familyId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl', 'role'])) ||
          (isSignedIn() && request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl', 'fcmToken', 'savingsGoalRewardId']));
      }

      match /taskTemplates/{templateId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /dailyTasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        // A parent can move a task to any status (approve to 'done', return
        // it, or complete their own task directly — self-approved). A child
        // may only submit their own task for approval or pull it back to
        // pending — never award themselves 'done' directly; that always
        // requires a parent action, which is what actually triggers XP.
        // Either path, if the template requires a photo, it must already be
        // on the resulting doc before the task can move toward completion —
        // submitted for a child, done for a parent self-completing their own
        // task directly (approving someone else's already-submitted task
        // doesn't need this check again: the photo requirement was already
        // enforced at submission time, and this update won't touch photoUrl).
        allow update: if isFamilyMember(familyId) &&
          (
            (isParent(familyId) &&
              (!(resource.data.assignedTo == request.auth.uid &&
                  resource.data.status != 'done' &&
                  request.resource.data.status == 'done') ||
                photoRequirementMet(familyId, resource.data.templateId, request.resource.data))) ||
            (resource.data.assignedTo == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'photoUrl']) &&
             request.resource.data.status in ['submitted', 'pending'] &&
             (request.resource.data.status != 'submitted' ||
               photoRequirementMet(familyId, resource.data.templateId, request.resource.data)))
          );
        allow create, delete: if isParent(familyId);
      }

      // xpLedger is append-only and only ever written by trusted server code
      // (Cloud Functions using the Admin SDK), never directly by clients.
      match /xpLedger/{entryId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /rewardRedemptions/{redemptionId} {
        allow read: if isFamilyMember(familyId);
        // Requests for a reward that needs approval must start 'requested';
        // rewards that don't need approval may self-create as 'approved'
        // (the onRedemptionApproved function still verifies + deducts XP).
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.userId == request.auth.uid &&
          (
            (rewardRequiresApproval(familyId, request.resource.data.rewardId) &&
              request.resource.data.status == 'requested') ||
            (!rewardRequiresApproval(familyId, request.resource.data.rewardId) &&
              request.resource.data.status == 'approved')
          );
        // requested -> approved/rejected (the usual decision), or
        // approved -> fulfilled (marking it actually handed over in real
        // life). Never any other transition — in particular an approved
        // redemption can't be rejected, since XP has already been spent.
        allow update: if isParent(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          (
            (resource.data.status == 'requested' && request.resource.data.status in ['approved', 'rejected']) ||
            (resource.data.status == 'approved' && request.resource.data.status == 'fulfilled')
          );
        allow delete: if false;
      }

      match /investments/{investmentId} {
        allow read: if isFamilyMember(familyId);
        // A member locks up their own XP — the Cloud Function that
        // processes this re-checks their live balance and cancels it if it
        // no longer covers the principal, so this is a soft client-side
        // check, not the actual guarantee.
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'active' &&
          // Mirrors lib/investments.ts's MIN_INVESTMENT_AMOUNT — update both if it ever changes.
          request.resource.data.principal is number && request.resource.data.principal >= 100 &&
          request.resource.data.termDays is number &&
          request.resource.data.rate is number;
        // Only the owner may request early withdrawal, only while active —
        // the actual XP return (principal only, interest forfeited) is
        // handled server-side.
        allow update: if isFamilyMember(familyId) &&
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'withdrawal_requested';
        // A parent may clean up old, already-settled investments (matured
        // or withdrawn) from the history — never 'active', since deleting
        // one wouldn't return the already-deducted principal to the
        // member's balance.
        allow delete: if isParent(familyId) && resource.data.status != 'active';
      }

      match /pooledContributions/{poolId} {
        allow read: if isFamilyMember(familyId);
        // A parent starts the pool — the family has already agreed in
        // person who's participating, so this is just bookkeeping. Always
        // starts 'collecting' with no pledges yet.
        allow create: if isParent(familyId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'collecting' &&
          request.resource.data.contributions.size() == 0 &&
          request.resource.data.invitedUserIds is list &&
          request.resource.data.invitedUserIds.size() > 0;
        allow update: if isFamilyMember(familyId) && resource.data.status == 'collecting' &&
          (
            // An invited member sets exactly their own pledge — never
            // anyone else's — capped at what they currently have.
            (request.auth.uid in resource.data.invitedUserIds &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributions']) &&
              request.resource.data.contributions.diff(resource.data.contributions).affectedKeys().hasOnly([request.auth.uid]) &&
              request.resource.data.contributions[request.auth.uid] is number &&
              request.resource.data.contributions[request.auth.uid] >= 0 &&
              request.resource.data.contributions[request.auth.uid] <=
                get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.xpBalance) ||
            // A parent finalizes (deducts every pledge) or calls it off.
            (isParent(familyId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
              request.resource.data.status in ['fulfilled', 'cancelled'])
          );
        allow delete: if false;
      }

      match /taskProposals/{proposalId} {
        allow read: if isFamilyMember(familyId);
        // Any family member — including a child — can propose a task for
        // themselves, always starting 'pending' with no approvals yet. If
        // this is a response to another member's TaskRequest (requestId
        // set), it must target that open request and be assigned to the
        // requester instead of self.
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.proposedBy == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.approvals.size() == 0 &&
          request.resource.data.xpValue is number && request.resource.data.xpValue > 0 &&
          (!('requestId' in request.resource.data) ||
            validRequestProposal(familyId, request.resource.data.requestId, request.resource.data.proposedBy, request.resource.data.assignedTo));
        // Voting: any *other* member may add exactly their own uid to
        // approvals (never someone else's, never more than one at a time),
        // or reject the proposal outright — one veto kills it. Only while
        // still 'pending'; the proposer never votes on their own proposal.
        // For a request-linked proposal this naturally includes the
        // requester, who gets a say over what lands on their own list.
        // A parent may also remove any individual pending proposal outright
        // — including their own — as a moderation action distinct from the
        // peer-voting veto above (that one excludes the proposer on purpose;
        // this one exists precisely so a parent can clear out their own or
        // anyone else's stale/unwanted proposal one at a time).
        allow update: if isFamilyMember(familyId) &&
          resource.data.status == 'pending' &&
          (
            (request.auth.uid != resource.data.proposedBy &&
              (
                (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvals']) &&
                  request.resource.data.approvals == resource.data.approvals.concat([request.auth.uid])) ||
                (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                  request.resource.data.status == 'rejected')
              )) ||
            (isParent(familyId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
              request.resource.data.status == 'rejected')
          );
        allow delete: if false;
      }

      match /taskRequests/{requesterId} {
        allow read: if isFamilyMember(familyId);
        // Doc ID is the requester's own uid, so this only ever fires the
        // first time they ever ask — reopening a closed one goes through
        // update below instead.
        allow create: if isFamilyMember(familyId) &&
          requesterId == request.auth.uid &&
          request.resource.data.requestedBy == request.auth.uid &&
          request.resource.data.status == 'open';
        // Self-cancel an open request, or start a new round after the last
        // one was fulfilled/cancelled. The open -> fulfilled transition is
        // never listed here — only the onTaskProposalWritten Cloud
        // Function (Admin SDK) performs that, when a linked proposal wins
        // unanimous approval.
        // A parent may also cancel any individual open request outright —
        // same moderation exception as taskProposals above — not just the
        // requester cancelling their own. 'date' is allowed alongside
        // status/timestamp so reopening on a new day resets which day the
        // request belongs to — otherwise it'd stay stamped with its
        // original creation date and look stale (or non-stale) forever.
        allow update: if isFamilyMember(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'timestamp', 'date']) &&
          (
            (requesterId == request.auth.uid &&
              (
                (resource.data.status == 'open' && request.resource.data.status == 'cancelled') ||
                (resource.data.status != 'open' && request.resource.data.status == 'open')
              )) ||
            (isParent(familyId) && resource.data.status == 'open' && request.resource.data.status == 'cancelled')
          );
        allow delete: if false;
      }

      match /xpAdjustmentRequests/{requestId} {
        allow read: if isFamilyMember(familyId);
        // Any parent can request an adjustment for any member (including
        // themselves) — it always starts 'requested'. A Cloud Function
        // auto-approves it if the family has no second parent to ever
        // approve it.
        allow create: if isParent(familyId) &&
          request.resource.data.requestedBy == request.auth.uid &&
          request.resource.data.status == 'requested' &&
          request.resource.data.delta is number && request.resource.data.delta != 0;
        // Only a *different* parent than the requester may decide it —
        // "second parent must approve" — and only while still 'requested'.
        allow update: if isParent(familyId) &&
          request.auth.uid != resource.data.requestedBy &&
          resource.data.status == 'requested' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['approved', 'rejected'];
        allow delete: if false;
      }

      // Visibility log for parent-facing actions — append-only, self-attested
      // by the client (same trust tier as `messages`, not a security
      // boundary; the real authorization for each action is enforced by that
      // action's own rules above). Only parents read it.
      match /auditLog/{entryId} {
        allow read: if isParent(familyId);
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['actorId', 'action', 'detail', 'timestamp']) &&
          request.resource.data.detail is string &&
          request.resource.data.detail.size() <= 300;
        allow update: if false;
        allow delete: if isParent(familyId);
      }

      // Family chat — an append-only log for everyone (anyone in the family
      // can read and post as themselves; individual messages can never be
      // edited). A parent may delete messages — the only way to clear it —
      // via Settings' "Vymazat historii chatu", which deletes every
      // message doc; there's no per-message delete/edit exposed anywhere.
      match /messages/{messageId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'text', 'timestamp']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isParent(familyId);
      }
    }
  }
}
