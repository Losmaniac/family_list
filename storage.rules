rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isParent(familyId) {
      return isFamilyMember(familyId) &&
        firestore.get(/databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'parent';
    }

    // Task proof photos: families/{familyId}/taskPhotos/{taskId}.jpg — only
    // the member the daily task is assigned to may upload the proof photo
    // for it (checked against Firestore, the source of truth for
    // assignment); any family member can view it once uploaded, same as
    // the daily task itself in Firestore. Only a parent may delete —
    // Settings' "Vymazat všechny fotky" bulk-clears them.
    match /families/{familyId}/taskPhotos/{taskId} {
      allow read: if isFamilyMember(familyId);
      allow write: if isFamilyMember(familyId) &&
        firestore.get(/databases/(default)/documents/families/$(familyId)/dailyTasks/$(taskId)).data.assignedTo == request.auth.uid &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isParent(familyId);
    }

    // Ad-hoc task proof photos: families/{familyId}/adHocTaskPhotos/{uid}/{fileId}
    // — there's no pre-existing per-task Firestore doc to check assignment
    // against like taskPhotos above (an ad-hoc completion doc is only ever
    // created after this upload, by completeAdHocTask), so the uid segment
    // of the path itself is the assignment check instead.
    match /families/{familyId}/adHocTaskPhotos/{uid}/{fileId} {
      allow read: if isFamilyMember(familyId);
      allow write: if isFamilyMember(familyId) && uid == request.auth.uid &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isParent(familyId);
    }
  }
}
